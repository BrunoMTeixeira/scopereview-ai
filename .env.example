# ─── AZURE AI FOUNDRY ────────────────────────────────────────────────────────
# Copy the Target URI from your model deployment in the Azure AI Foundry portal
AZURE_ENDPOINT=https://<resource-name>.services.ai.azure.com/models/chat/completions?api-version=2024-05-01-preview

# The name of your model deployment (exactly as it appears in the portal)
AZURE_MODEL=Llama-3.3-70B-Instruct

# API key from your Azure AI Foundry deployment
AZURE_API_KEY=<your-api-key>

# ─── AZURE DEVOPS ─────────────────────────────────────────────────────────────
# Azure DevOps — numeric organisation ID (visible in the ADO URL)
ADO_ORGANIZATION=<your-org-id>

# Personal Access Token with scopes: Code (Read) + Pull Request Threads (Read & Write)
ADO_PAT=<your-personal-access-token>

# ─── SECURITY ─────────────────────────────────────────────────────────────────
# Shared secret for webhook verification (configure the same value in ADO Service Hooks)
# Leave empty to disable webhook authentication (not recommended for production)
WEBHOOK_SECRET=

# ─── TUNING ───────────────────────────────────────────────────────────────────
# Maximum total tokens before stopping code review analysis (prevents runaway costs)
MAX_TOKEN_BUDGET=50000

# Number of HIGH-severity findings before blocking merge (CRITICALs always block)
# Set to 0 to block on any HIGH finding, or increase for more lenient reviews
MAX_HIGH_BLOCK=3
