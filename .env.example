# ─── AZURE AI FOUNDRY ────────────────────────────────────────────────────────
# Endpoint do recurso Azure AI Foundry (obtido no portal Azure)
AZURE_ENDPOINT=https://<resource-name>.services.ai.azure.com/models/chat/completions?api-version=2024-05-01-preview

# Nome do modelo implementado no Azure AI Foundry
AZURE_MODEL=Phi-4-mini-instruct

# Chave de API do recurso Azure AI Foundry
AZURE_API_KEY=<a-tua-api-key>

# ─── AZURE DEVOPS ─────────────────────────────────────────────────────────────
# Nome da organização no Azure DevOps (visível no URL: dev.azure.com/<organização>)
ADO_ORGANIZATION=<nome-da-organizacao>

# Personal Access Token com permissões: Code (Read), Pull Request Threads (Read & Write)
ADO_PAT=<o-teu-pat>
