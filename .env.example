# ─── AZURE AI FOUNDRY ────────────────────────────────────────────────────────
# --- Agent for code review ---
AZURE_ENDPOINT_CR=https://codereview-poc-
AZURE_MODEL_CR=o4-mini-1
AZURE_API_KEY_CR=

# --- Agent for requirements review ---
AZURE_ENDPOINT_REQ=https://codereview-poc-
AZURE_MODEL_REQ=DeepSeek-V3.2-1
AZURE_API_KEY_REQ=



# ─── AZURE DEVOPS ─────────────────────────────────────────────────────────────
# Azure DevOps — numeric organisation ID (visible in the ADO URL)
ADO_ORGANIZATION=<your-org-id>

# Personal Access Token with scopes: Code (Read) + Pull Request Threads (Read & Write)
ADO_PAT=<your-personal-access-token>

# ─── SECURITY ─────────────────────────────────────────────────────────────────
# Shared secret for webhook verification (configure the same value in ADO Service Hooks)
# Leave empty to disable webhook authentication (not recommended for production)
WEBHOOK_SECRET=

# ─── TUNING ───────────────────────────────────────────────────────────────────
# Maximum number of concurrent workers processing PRs
# Limits API concurrency to prevent 429 errors and controls RAM usage
# Default is 3
MAX_WORKERS= 3

# Maximum total tokens before stopping code review analysis (prevents runaway costs)
MAX_TOKEN_BUDGET=50000

# Number of HIGH-severity findings before blocking merge (CRITICALs always block)
# Set to 0 to block on any HIGH finding, or increase for more lenient reviews
MAX_HIGH_BLOCK=3

# Maximum number of changed files to analyze per PR (files beyond this limit are ignored)
# Increase for larger PRs, but be aware of token budget and API cost implications
# Range: 1–50
MAX_FILES=

# Maximum number of lines to fetch per file (longer files are truncated)
# Range: 50–2000
MAX_LINES=

# Maximum completion tokens for the Requirements Validation agent response
# Increase if requirements reviews are being cut off for complex PRs
# Range: 1000+
REQUIREMENTS_MAX_COMPLETION_TOKENS=

# HTTP timeout in seconds for Azure DevOps API calls
# Increase if you experience timeouts on slow networks
ADO_REQUEST_TIMEOUT=

# ─── DEDUPLICATION & CACHING ──────────────────────────────────────────────────
# Optional Redis URL for distributed deduplication (required when running multiple replicas).
# If running via Docker Compose, this is automatically injected as redis
# If running locally via Python/Uvicorn without this variable, it falls back to in-memory deduplication.
# DEDUP_REDIS_URL=
